body {
    background-color: #020617; 
}

/* ====== 背景コンテナ（うねりとズーム） ====== */
.bg-container {
    position: fixed;
    top: -5%; left: -5%;
    width: 110vw; height: 110vh;
    background: url('bg.webp') no-repeat center center / cover;
    z-index: -3;
    animation: drift-1 30s infinite alternate ease-in-out;
    filter: url(#spatial-warp) brightness(0.85); /* 空間の歪みフィルター */
}
.bg-container-2 {
    position: fixed;
    top: -5%; left: -5%;
    width: 110vw; height: 110vh;
    background: url('bg.webp') no-repeat center center / cover;
    z-index: -2;
    opacity: 0.2;
    mix-blend-mode: color-dodge;
    animation: drift-2 25s infinite alternate ease-in-out;
    filter: url(#spatial-warp); /* 空間の歪みフィルター */
}

@keyframes drift-1 {
    0%   { transform: scale(1) rotate(0deg) translateX(0);       filter: brightness(1) hue-rotate(0deg) blur(0px); }
    25%  { transform: scale(1.03) rotate(0.4deg) translateX(-8px); filter: brightness(0.8) hue-rotate(-8deg) blur(0.5px); }
    50%  { transform: scale(1.01) rotate(-0.2deg) translateX(5px); filter: brightness(0.85) hue-rotate(5deg) blur(1px); }
    75%  { transform: scale(1.04) rotate(0.3deg) translateX(-3px); filter: brightness(0.75) hue-rotate(-3deg) blur(0.5px); }
    100% { transform: scale(1) rotate(0deg) translateX(0);        filter: brightness(1) hue-rotate(0deg) blur(0px); }
}
@keyframes drift-2 {
    0%   { transform: scaleX(-1) scale(1) translateY(0) rotate(0deg);       filter: brightness(0.5) hue-rotate(0deg); }
    33%  { transform: scaleX(-1) scale(1.05) translateY(-10px) rotate(-0.5deg); filter: brightness(0.4) hue-rotate(10deg); }
    66%  { transform: scaleX(-1) scale(1.02) translateY(8px) rotate(0.3deg);  filter: brightness(0.6) hue-rotate(-5deg); }
    100% { transform: scaleX(-1) scale(1) translateY(0) rotate(0deg);        filter: brightness(0.5) hue-rotate(0deg); }
}

/* 暗幕 */
.dark-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: radial-gradient(ellipse at 50% 20%, rgba(23, 6, 12, 0.7) 0%, rgba(15, 3, 6, 0.98) 75%);
    z-index: -1;
}

/* フィルムノイズ */
.noise-bg {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none; z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.04;
    mix-blend-mode: overlay;
}

/* ====== 不可解な視覚レイヤー ====== */

/* Canvas（JSで制御される抽象パーティクル） */
#anomaly-canvas {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    pointer-events: none;
    z-index: 2;
    opacity: 0.35;
    filter: blur(1.5px);
}

/* 走査線（古いモニター風） */
.scanlines {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 3;
    background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0,0,0,0.06) 2px,
        rgba(0,0,0,0.06) 4px
    );
    animation: scanline-flicker 8s infinite linear;
}

@keyframes scanline-flicker {
    0%, 100% { opacity: 0.5; }
    50%      { opacity: 0.3; }
    73%      { opacity: 0.6; }
    91%      { opacity: 0.2; }
}

/* ====== 汎用パネルスタイル ====== */
/* ====== 不気味な微細震動と影（露骨でない演出） ====== */
@keyframes eerie-tremor {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    20%      { transform: translate(-0.3px, 0.4px) rotate(-0.05deg); }
    40%      { transform: translate(0.4px, -0.2px) rotate(0.04deg); }
    60%      { transform: translate(-0.2px, -0.3px) rotate(-0.03deg); }
    80%      { transform: translate(0.3px, 0.3px) rotate(0.02deg); }
}

.panel {
    background: rgba(0,0,0,0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.05);
    box-shadow: 0 10px 30px rgba(0,0,0,0.8), inset 0 0 40px rgba(0,0,0,0.9);
    animation: eerie-tremor 16s infinite ease-in-out;
}

/* じわっと落ちる不気味な影のビネット */
body::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.85), inset 0 0 50px rgba(15, 3, 6, 0.5);
    opacity: 0.85;
}

/* ====== スプレッドシート（スケジュール表）の極上クリーン化 ====== */
#schedule-table-wrap {
    border: none !important;
    background: rgba(2, 6, 23, 0.92);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.9);
}

#schedule-table-wrap table {
    border-collapse: collapse;
    width: 100%;
}

#schedule-table-wrap th,
#schedule-table-wrap td {
    border: none !important;
    background: transparent !important;
}

#schedule-table-wrap tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    transition: background-color 0.3s ease;
}

#schedule-table-wrap tr:hover {
    background-color: rgba(153, 27, 27, 0.04) !important;
}

.sheet-gap-cell {
    width: 0.5rem !important;
    min-width: 0.5rem !important;
    background: rgba(0, 0, 0, 0.6) !important;
    border: none !important;
}

/* マップのセル */
.map-cell {
    flex: 1;
    border: 1px dashed rgba(100,116,139,0.45);
    background: linear-gradient(135deg,
        rgba(15,23,42,0.55) 0%,
        rgba(15,23,42,0.35) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    cursor: default;
    padding: 0.5rem;
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
}
/* 難易度が高いほど、紺色に血の色が濃く混ざる */
.map-cell {
    background: linear-gradient(135deg,
        rgba(15,23,42,0.55) 0%,
        rgba(153,27,27, calc(var(--blood, 0) * 0.5)) 100%);
    border-color: rgba(153,27,27, calc(var(--blood, 0) * 0.55));
    box-shadow: inset 0 0 18px rgba(153,27,27, calc(var(--blood, 0) * 0.18));
}
.map-cell:hover, .map-cell:active {
    background: linear-gradient(135deg,
        rgba(15,23,42,0.65) 0%,
        rgba(153,27,27, calc(var(--blood, 0) * 0.6 + 0.08)) 100%);
}

/* 難易度表示（マップセル内） */
.map-cell .difficulty-stars {
    font-size: 10px;
    color: rgba(153,27,27, calc(0.5 + var(--blood, 0) * 0.45));
    letter-spacing: 1px;
    margin-top: 2px;
    font-family: "Fira Code", monospace;
    text-shadow: 0 0 6px rgba(153,27,27, calc(var(--blood, 0) * 0.5));
}

/* ====== 教室紹介 ====== */
.classroom-item {
    background: rgba(15,23,42,0.35);
    border: 1px solid rgba(100,116,139,0.25);
    border-left: 2px solid rgba(153,27,27,0.35);
    padding: 1rem 1.25rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
}
.classroom-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
        radial-gradient(ellipse at 0% 0%, rgba(153,27,27,0.03) 0%, transparent 40%),
        radial-gradient(ellipse at 100% 100%, rgba(100,116,139,0.02) 0%, transparent 35%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
}
.classroom-item::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(153,27,27,0.15), transparent);
    opacity: 0.5;
}
.classroom-item:hover {
    background: rgba(20,30,50,0.5);
    border-left-color: rgba(153,27,27,0.6);
    border-color: rgba(153,27,27,0.2);
}
.classroom-item:hover::before {
    opacity: 1;
}
.classroom-item .classroom-name {
    font-family: "Fira Code", monospace;
    font-size: 0.85rem;
    font-weight: bold;
    color: rgba(255,255,255,0.95);
    margin-bottom: 0.35rem;
    letter-spacing: 0.05em;
    position: relative;
    z-index: 1;
}
.classroom-item .classroom-difficulty {
    font-size: 0.8rem;
    color: rgba(153,27,27,0.75);
    letter-spacing: 1.5px;
    margin-bottom: 0.5rem;
    font-family: "Fira Code", monospace;
    position: relative;
    z-index: 1;
    text-shadow: 0 0 8px rgba(153,27,27,0.2);
}
.classroom-item .classroom-description {
    font-size: 0.78rem;
    color: rgba(148,163,184,0.65);
    line-height: 1.7;
    font-style: italic;
    position: relative;
    z-index: 1;
    font-family: "Shippori Mincho", serif;
    letter-spacing: 0.02em;
}

/* 重力ワープ時のマップセル追従 */
.gravity-warp .map-cell {
    transition: transform 0.12s ease-out, filter 0.12s ease-out, background 0.3s, border-color 0.3s, box-shadow 0.3s;
}
.gravity-warp .map-cell.warped {
    transform: scale(1.015) translateX(var(--warp-x, 0)) translateY(var(--warp-y, 0));
    filter: brightness(0.97);
}

/* ====== 重力ワープ（局所的な空間歪み） ====== */
.gravity-warp {
    position: relative;
    overflow: visible;
}

/* 重力の「重み」を感じさせる微細な歪みアニメーション */
@keyframes gravity-pulse {
    0%, 100% { 
        transform: scale(1) translate(0, 0); 
        filter: url(#spatial-warp);
    }
    25% { 
        transform: scale(1.0008) translate(-0.2px, 0.1px); 
        filter: url(#spatial-warp) blur(0.1px);
    }
    50% { 
        transform: scale(0.9992) translate(0.1px, -0.2px); 
        filter: url(#spatial-warp) brightness(0.995);
    }
    75% { 
        transform: scale(1.0004) translate(-0.1px, 0.05px); 
        filter: url(#spatial-warp);
    }
}

.gravity-warp::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: radial-gradient(ellipse at center, rgba(153, 27, 27, 0.015) 0%, transparent 70%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease-out;
    z-index: -1;
}

.gravity-warp:hover::before {
    opacity: 1;
}

/* マウス追従型の重力歪み（JSで制御） */
.gravity-warp.active-warp {
    animation: gravity-pulse 12s infinite ease-in-out;
}

.gravity-warp.active-warp::before {
    opacity: 1;
    animation: gravity-glow 6s infinite ease-in-out;
}

@keyframes gravity-glow {
    0%, 100% { 
        background: radial-gradient(ellipse at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(153, 27, 27, 0.02) 0%, transparent 65%);
        filter: blur(0.5px);
    }
    50% { 
        background: radial-gradient(ellipse at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(153, 27, 27, 0.035) 0%, transparent 75%);
        filter: blur(1px);
    }
}

/* より強い違和感：予約状況以外のセルだけに重力影響 */
.gravity-warp td {
    transition: transform 0.12s ease-out, filter 0.12s ease-out, text-shadow 0.12s ease-out;
}

.gravity-warp td.warped {
    transform: scale(1.012) translateX(var(--warp-x, 0)) translateY(var(--warp-y, 0));
    filter: blur(0.22px) brightness(0.96);
    text-shadow: 1px 0 rgba(239,68,68,0.18), -1px 0 rgba(96,165,250,0.12);
}

.gravity-warp .reservation-cell,
.gravity-warp .reservation-cell.warped {
    transform: none;
    filter: none;
}

/* 統計カードの個別歪み */
#stat-entered.gravity-warp,
#stat-remaining.gravity-warp {
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* マップパネルの重力歪み - セルレベルで制御するためパネル自体は微細のみ */
#map-panel.gravity-warp {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

#map-panel.gravity-warp.active-warp {
    /* パネル自体のアニメーションは無効化（セルレベルで表現） */
    animation: none;
}

/* セクション区切り線（抽象的な線） */
.divider-line {
    width: 60px;
    height: 1px;
    margin: 0 auto;
    background: linear-gradient(90deg, transparent, rgba(153,27,27,0.4), transparent);
    position: relative;
}

/* ====== フェードイン ====== */
.fade-in { opacity: 0; transform: translateY(10px); }

/* ====== 同期ステータス ====== */
#sync-status {
    transition: opacity 0.2s ease;
}

/* ====== テーブル ====== */
#schedule-table-wrap {
    max-height: 70vh;
    min-height: 320px;
    overflow-x: auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(0,0,0,0.55);
    border-radius: 8px;
}

#schedule-table-wrap table {
    table-layout: fixed;
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
}

#schedule-table-wrap th,
#schedule-table-wrap td {
    padding: 0.35rem 0.2rem !important;
    font-size: 0.75rem;
    text-align: center;
}

/* Day 1 (8/22) */
#schedule-table-wrap th:nth-child(1),
#schedule-table-wrap td:nth-child(1) { width: 17%; font-family: monospace; }

#schedule-table-wrap th:nth-child(2),
#schedule-table-wrap td:nth-child(2) { width: 12%; }

#schedule-table-wrap th:nth-child(3),
#schedule-table-wrap td:nth-child(3) { width: 8%; font-family: monospace; }

#schedule-table-wrap th:nth-child(4),
#schedule-table-wrap td:nth-child(4) { width: 13%; font-weight: bold; }

/* Day 2 (8/23) */
#schedule-table-wrap th:nth-child(5),
#schedule-table-wrap td:nth-child(5) { width: 17%; font-family: monospace; border-left: 1px solid rgba(255,255,255,0.12) !important; }

#schedule-table-wrap th:nth-child(6),
#schedule-table-wrap td:nth-child(6) { width: 12%; }

#schedule-table-wrap th:nth-child(7),
#schedule-table-wrap td:nth-child(7) { width: 8%; font-family: monospace; }

#schedule-table-wrap th:nth-child(8),
#schedule-table-wrap td:nth-child(8) { width: 13%; font-weight: bold; }

/* ====== スマホ対応（768px以下） ====== */
@media (max-width: 768px) {
    #schedule-table-wrap {
        max-height: 80vh;
        min-height: 400px;
        border-radius: 4px;
    }

    #schedule-table-wrap table {
        min-width: 100%;
        font-size: 0.7rem;
    }

    #schedule-table-wrap th,
    #schedule-table-wrap td {
        padding: 0.4rem 0.15rem !important;
        font-size: 0.7rem;
    }

    /* スマホではカラムを調整 */
    #schedule-table-wrap th:nth-child(1),
    #schedule-table-wrap td:nth-child(1) { width: 18%; }

    #schedule-table-wrap th:nth-child(2),
    #schedule-table-wrap td:nth-child(2) { width: 14%; }

    #schedule-table-wrap th:nth-child(3),
    #schedule-table-wrap td:nth-child(3) { width: 10%; }

    #schedule-table-wrap th:nth-child(4),
    #schedule-table-wrap td:nth-child(4) { width: 14%; }

    #schedule-table-wrap th:nth-child(5),
    #schedule-table-wrap td:nth-child(5) { width: 18%; border-left: 1px solid rgba(255,255,255,0.12) !important; }

    #schedule-table-wrap th:nth-child(6),
    #schedule-table-wrap td:nth-child(6) { width: 14%; }

    #schedule-table-wrap th:nth-child(7),
    #schedule-table-wrap td:nth-child(7) { width: 10%; }

    #schedule-table-wrap th:nth-child(8),
    #schedule-table-wrap td:nth-child(8) { width: 14%; }

    /* スマホでのテーブル行の高さ調整 */
    #schedule-table-wrap tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    /* スマホでの予約状況セルの強調 */
    .reservation-cell {
        background: rgba(153,27,27,0.12);
        letter-spacing: 0.04em;
    }
}

/* ====== 超小型スマホ対応（480px以下） ====== */
@media (max-width: 480px) {
    #schedule-table-wrap {
        max-height: 85vh;
        min-height: 450px;
    }

    #schedule-table-wrap th,
    #schedule-table-wrap td {
        padding: 0.35rem 0.1rem !important;
        font-size: 0.65rem;
    }

    #schedule-table-wrap table {
        min-width: 100%;
    }

    /* 超小型では全カラムを均等に */
    #schedule-table-wrap th,
    #schedule-table-wrap td {
        width: 12.5% !important;
    }
}

.table-row-hover:hover,
.table-row-hover:active { background-color: rgba(255,255,255,0.04); }

.reservation-cell {
    background: rgba(153,27,27,0.08);
    letter-spacing: 0.06em;
    text-shadow: 0 0 4px rgba(239,68,68,0.32);
}

@keyframes eerie-shiver {
    0%, 100% { transform: translateX(0); }
    25%      { transform: translateX(-0.3px); }
    75%      { transform: translateX(0.3px); }
}

.eerie-shiver {
    animation: eerie-shiver 3s infinite ease-in-out;
}

.sheet-gap-cell {
    width: 0.65rem;
    min-width: 0.65rem;
    border-left: 1px solid rgba(255,255,255,0.03);
    border-right: 1px solid rgba(255,255,255,0.03);
    background: rgba(0,0,0,0.35);
}

.sheet-updated {
    animation: sheet-refresh 0.7s ease-out;
}

@keyframes sheet-refresh {
    0% { filter: brightness(1.4); }
    100% { filter: brightness(1); }
}

/* ちかちかする演出を停止し、ゆっくりと呼吸するような暗い脈動（ダークブレス）に変更 */
@keyframes dark-pulse {
    0%, 100% { opacity: 0.85; filter: brightness(1); }
    50%      { opacity: 0.65; filter: brightness(0.92); }
}

.dark-breath {
    animation: dark-pulse 6s infinite ease-in-out;
}

/* 従来の激しいホバー演出を穏やかな深みのある変化に置換 */
.glitch-hover:hover,
.glitch-hover:active {
    color: #fca5a5;
    text-shadow: 0 0 10px rgba(153, 27, 27, 0.4);
    transition: color 0.4s ease, text-shadow 0.4s ease;
}

/* ====== 「学校23不思議」の揺れと血に染まるエフェクト ====== */
@keyframes title-shiver {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    15%      { transform: translate(-0.8px, 0.6px) rotate(-0.1deg); }
    30%      { transform: translate(0.7px, -0.6px) rotate(0.15deg); }
    45%      { transform: translate(-0.5px, -0.7px) rotate(-0.05deg); }
    60%      { transform: translate(0.8px, 0.5px) rotate(0.1deg); }
    75%      { transform: translate(-0.6px, -0.4px) rotate(-0.15deg); }
    90%      { transform: translate(0.5px, 0.7px) rotate(0.05deg); }
}

@keyframes blood-bleed {
    0%, 100% {
        color: #ffffff;
        text-shadow: 0 0 15px rgba(153, 27, 27, 0.5), 0 0 35px rgba(153, 27, 27, 0.25);
    }
    50% {
        color: #fca5a5;
        text-shadow: 0 0 25px rgba(239, 68, 68, 0.8), 0 0 55px rgba(153, 27, 27, 0.6), 0 0 90px rgba(127, 29, 29, 0.4);
    }
}

.title-bleed-shiver {
    animation: title-shiver 5s infinite ease-in-out, blood-bleed 7s infinite ease-in-out;
    cursor: default;
}

.title-bleed-shiver:hover {
    animation: title-shiver 0.2s infinite ease-in-out, blood-bleed 1s infinite ease-in-out;
    color: #f87171;
    text-shadow: 0 0 35px rgba(239, 68, 68, 0.95), 0 0 70px rgba(153, 27, 27, 0.85), 0 0 110px rgba(127, 29, 29, 0.7);
}

/* 幽霊文字：変色・揺れ・ランダムに文字が踊る */
@keyframes haunted-color {
    0%, 100% { color: #e2e8f0; }
    25%      { color: #fca5a5; }
    50%      { color: #94a3b8; }
    75%      { color: #ef4444; }
}

@keyframes haunted-shiver {
    0%, 100% { transform: translate(0, 0); }
    20%      { transform: translate(-0.5px, 0.5px); }
    40%      { transform: translate(0.5px, -0.5px); }
    60%      { transform: translate(-0.3px, -0.3px); }
    80%      { transform: translate(0.3px, 0.3px); }
}

.text-haunted-dance {
    animation: haunted-color 6s infinite ease-in-out, haunted-shiver 4s infinite ease-in-out;
    cursor: default;
    transition: all 0.3s ease;
}

.text-haunted-dance .haunted-char {
    display: inline-block;
    animation: char-dance 2s infinite ease-in-out;
}

@keyframes char-dance {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    25%      { transform: translateY(-2px) rotate(-1deg); }
    50%      { transform: translateY(1px) rotate(0.5deg); }
    75%      { transform: translateY(-1px) rotate(-0.5deg); }
}

/* 人魂・人影の靄（背景） */
.hitodama {
    position: fixed;
    pointer-events: none;
    z-index: 0;
    border-radius: 50%;
    filter: blur(48px);
    opacity: 0.2;
    animation: hitodama-float 22s infinite ease-in-out, hitodama-pulse 5s infinite ease-in-out;
}

.hitodama-blue {
    background: radial-gradient(circle at 30% 30%, rgba(100, 200, 255, 0.4), rgba(50, 100, 200, 0.15) 40%, transparent 70%);
}

.hitodama-red {
    background: radial-gradient(circle at 30% 30%, rgba(255, 100, 100, 0.35), rgba(200, 50, 50, 0.15) 40%, transparent 70%);
}

.hitodama-white {
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.3), rgba(200, 220, 255, 0.1) 40%, transparent 70%);
}

.human-silhouette {
    position: fixed;
    pointer-events: none;
    z-index: 0;
    opacity: 0.025;
    filter: blur(65px);
    background: linear-gradient(180deg, 
        rgba(150, 180, 220, 0) 0%,
        rgba(80, 120, 180, 0.6) 20%,
        rgba(40, 80, 150, 0.8) 50%,
        rgba(20, 60, 120, 0.6) 80%,
        rgba(10, 30, 80, 0) 100%);
    clip-path: polygon(
        50% 0%,
        55% 15%, 60% 15%, 60% 25%, 68% 25%, 68% 35%, 58% 35%, 58% 45%, 65% 45%, 65% 55%, 55% 55%, 55% 65%, 62% 65%, 62% 75%, 52% 75%, 52% 85%, 48% 85%, 48% 75%, 38% 75%, 38% 65%, 45% 65%, 45% 55%, 35% 55%, 35% 45%, 42% 45%, 42% 35%, 32% 35%, 32% 25%, 40% 25%, 40% 15%, 45% 15%
    );
    animation: silhouette-drift 25s infinite ease-in-out, silhouette-fade 8s infinite ease-in-out;
}

@keyframes hitodama-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(40px, -60px) scale(1.1); }
    50% { transform: translate(-30px, -100px) scale(0.9); }
    75% { transform: translate(-50px, -40px) scale(1.05); }
}

@keyframes hitodama-pulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.15); }
}

@keyframes silhouette-drift {
    0%, 100% { transform: translateX(0) translateY(0) scale(1); }
    33% { transform: translateX(50px) translateY(-30px) scale(1.05); }
    66% { transform: translateX(-40px) translateY(20px) scale(0.95); }
}

@keyframes silhouette-fade {
    0%, 100% { opacity: 0.06; }
    50% { opacity: 0.12; }
}

/* ====== 隠し文字 ====== */
.hidden-text { color: transparent; user-select: all; -webkit-user-select: all; }
.hidden-text::selection { background: rgba(153,27,27,0.6); color: #ef4444; }

/* ====== スクロールバー ====== */
::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: #000; }
::-webkit-scrollbar-thumb { background: #1e293b; }

/* ====== 黒板の汚い数式（背景と一緒に動く） ====== */
.blackboard-math {
    position: absolute;
    /* 黒板のありそうな位置（画面中央少し上、左寄り）に配置 */
    top: 35%;
    left: 68%;
    transform: translate(-50%, -50%) rotate(-3deg) skewX(-10deg); /* 殴り書き感を出すための傾きと歪み */
    color: rgba(255, 255, 255, 0.15); /* さっきより少しだけ見えやすく */
    font-family: "Kalam", "Shadows Into Light", "Bradley Hand", "Comic Sans MS", cursive, serif;
    font-size: 0.85rem; /* 文字を少し大きく */
    line-height: 1.1;
    letter-spacing: -0.5px;
    opacity: 0.8;
    mix-blend-mode: screen; /* overlayより明るく白が乗るように */
    filter: blur(0.5px); /* チョークの粉っぽさ・消えかけの感じ */
}
.blackboard-math .math-block {
    text-align: left;
    white-space: nowrap;
}
